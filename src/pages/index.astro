---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import EventCard from '../components/EventCard.astro';
import type { EventData } from '../components/EventCard.astro';
import eventsRaw from '../data/events.json';

const events = (eventsRaw as EventData[]).sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const counts = {
  all:             events.length,
  lecture:         events.filter(e => e.type === 'lecture').length,
  'journal-club':  events.filter(e => e.type === 'journal-club').length,
  'science-meeting': events.filter(e => e.type === 'science-meeting').length,
};
---

<Layout>
  <Nav />

  <!-- ── HERO ─────────────────────────────────────────────────────── -->
  <div class="relative">
    <img
      src="/fig1.png"
      alt="L'EMbeDS DS³ — Data Science Seminar Series, Pisa"
      class="w-full h-52 sm:h-72 lg:h-80 object-cover object-center"
    />
    <!-- subtle gradient to connect hero with cream background -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#faf8f5]/60 pointer-events-none" />
  </div>

  <!-- ── ABOUT ──────────────────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-12 text-center">
    <h1 class="font-serif text-4xl sm:text-5xl font-bold text-stone-900 mb-1">
      L'EMbeDS <span class="text-[#9f1239]">DS³</span>
    </h1>
    <p class="text-base text-stone-500 font-medium tracking-wide uppercase mb-5">
      Data Science Seminar Series
    </p>
    <p class="text-base sm:text-lg text-stone-600 leading-relaxed mb-6">
      A weekly seminar on the methodology of data science, its applications, and related
      governance issues — hosted by the{' '}
      <a
        href="https://www.santannapisa.it/en/institute/economics/lembed-s-laboratory-economics-management-big-data"
        class="text-[#9f1239] hover:underline font-medium"
        target="_blank"
        rel="noopener"
      >L'EMbeDS Department of Excellence</a>{' '}
      at Sant'Anna School of Advanced Studies, Pisa.
    </p>

    <!-- Format legend -->
    <div class="flex flex-wrap justify-center gap-3 mb-6">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold uppercase tracking-wide border border-blue-100">
        <span class="w-2 h-2 rounded-full bg-blue-600 inline-block"></span>
        Lecture — Invited academic talk
      </span>
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold uppercase tracking-wide border border-amber-100">
        <span class="w-2 h-2 rounded-full bg-amber-600 inline-block"></span>
        Science Meeting — Ongoing research
      </span>
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold uppercase tracking-wide border border-emerald-100">
        <span class="w-2 h-2 rounded-full bg-emerald-600 inline-block"></span>
        Journal Club — Published paper discussion
      </span>
    </div>

    <!-- CTA row -->
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="#events"
        class="inline-flex items-center gap-2 bg-[#9f1239] text-white text-sm font-semibold px-5 py-2.5 rounded-full hover:bg-[#881030] transition-colors shadow-sm"
      >
        Browse all events
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      <a
        href="https://groups.google.com/g/lembedsds3"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 bg-white border border-stone-300 text-stone-700 text-sm font-semibold px-5 py-2.5 rounded-full hover:border-stone-400 hover:bg-stone-50 transition-colors"
      >
        Stay updated
      </a>
    </div>
  </section>

  <!-- ── SCHEDULE BANNER ────────────────────────────────────────────── -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
    <div class="rounded-2xl bg-stone-900 text-white px-6 py-5 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex items-center gap-3 shrink-0">
        <svg class="w-6 h-6 text-[#f5c6d0]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" />
        </svg>
        <span class="font-semibold text-white">Fall 2026 Schedule</span>
      </div>
      <p class="text-sm text-stone-300 leading-relaxed">
        Sessions resume every <strong class="text-white">Wednesday from September 2026</strong>, cycling through
        Lectures, Science Meetings, Journal Clubs, and Jolly sessions (10:00 AM Italian Time · Online via Teams).
      </p>
    </div>
  </div>

  <!-- ── EVENTS GRID ────────────────────────────────────────────────── -->
  <section id="events" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">

    <!-- Section header -->
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-stone-900">All Events</h2>
      <span id="count-label" class="text-sm text-stone-400">{counts.all} events</span>
    </div>

    <!-- Filter bar -->
    <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="Filter by event type">
      <button
        class="filter-pill active"
        data-filter="all"
        data-count={counts.all}
      >
        All <span class="pill-count">{counts.all}</span>
      </button>
      <button
        class="filter-pill"
        data-filter="lecture"
        data-count={counts.lecture}
      >
        Lecture <span class="pill-count">{counts.lecture}</span>
      </button>
      <button
        class="filter-pill"
        data-filter="journal-club"
        data-count={counts['journal-club']}
      >
        Journal Club <span class="pill-count">{counts['journal-club']}</span>
      </button>
      <button
        class="filter-pill"
        data-filter="science-meeting"
        data-count={counts['science-meeting']}
      >
        Science Meeting <span class="pill-count">{counts['science-meeting']}</span>
      </button>
    </div>

    <!-- Card grid -->
    <div id="event-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {events.map(event => (
        <div class="event-wrapper" data-type={event.type}>
          <EventCard event={event} />
        </div>
      ))}
    </div>

    <!-- Empty state (shown when filter has no matches) -->
    <div id="empty-state" class="hidden py-20 text-center text-stone-400">
      <svg class="w-10 h-10 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 15.803 7.5 7.5 0 0015.803 15.803z" />
      </svg>
      <p class="text-sm font-medium">No events match this filter.</p>
    </div>
  </section>

  <!-- ── FOOTER ─────────────────────────────────────────────────────── -->
  <footer class="border-t border-stone-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-stone-500">
      <div class="font-serif">
        <span class="font-bold text-[#9f1239]">L'EMbeDS</span>
        <span class="text-stone-600"> DS³</span>
        <span> · Sant'Anna School of Advanced Studies, Pisa</span>
      </div>
      <nav class="flex gap-5">
        <a href="/" class="hover:text-stone-800 transition-colors">Events</a>
        <a href="/credits" class="hover:text-stone-800 transition-colors">Credits & Links</a>
      </nav>
    </div>
  </footer>
</Layout>

<!-- ── FILTER STYLES ──────────────────────────────────────────────── -->
<style>
  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1.5px solid #e7e5e4;
    color: #57534e;
    background: white;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .filter-pill:hover {
    border-color: #a8a29e;
    color: #1c1917;
  }
  .filter-pill.active {
    background: #1c1917;
    border-color: #1c1917;
    color: white;
  }
  .filter-pill[data-filter="lecture"].active {
    background: #2563eb;
    border-color: #2563eb;
  }
  .filter-pill[data-filter="journal-club"].active {
    background: #059669;
    border-color: #059669;
  }
  .filter-pill[data-filter="science-meeting"].active {
    background: #d97706;
    border-color: #d97706;
  }
  .pill-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    background: rgba(0,0,0,0.12);
    padding: 0 0.3rem;
  }
  .filter-pill.active .pill-count {
    background: rgba(255,255,255,0.25);
  }
</style>

<!-- ── FILTER SCRIPT ───────────────────────────────────────────────── -->
<script>
  const pills    = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const wrappers = document.querySelectorAll<HTMLElement>('.event-wrapper');
  const empty    = document.getElementById('empty-state');
  const countLbl = document.getElementById('count-label');

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter!;

      // Update active pill
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');

      // Show / hide cards
      let visible = 0;
      wrappers.forEach(w => {
        const show = filter === 'all' || w.dataset.type === filter;
        w.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      // Update count label
      if (countLbl) {
        countLbl.textContent = `${visible} event${visible !== 1 ? 's' : ''}`;
      }

      // Empty state
      if (empty) empty.classList.toggle('hidden', visible > 0);
    });
  });
</script>
