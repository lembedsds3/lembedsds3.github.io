---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import EventCard from '../components/EventCard.astro';
import type { EventData } from '../components/EventCard.astro';
import eventsRaw from '../data/events.json';

const allEvents = (eventsRaw as EventData[]).sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

// Split at build time: events dated today or later are "upcoming" (soonest first)
const todayStr       = new Date().toISOString().slice(0, 10);
const upcomingEvents = allEvents.filter(e => e.date >= todayStr).reverse();
const recentEvents   = allEvents.filter(e => e.date < todayStr).slice(0, 6);
const totalCount     = allEvents.length;
---

<Layout>
  <Nav />

  <!-- ── HERO BANNER ─────────────────────────────────── -->
  <div class="flex justify-center py-6 px-4">
    <img
      src="/logo.png"
      alt="L'EMbeDS DS³ — Data Science Seminar Series"
      class="block w-auto"
      style="max-height: 220px;"
    />
  </div>

  <!-- ── ABOUT ──────────────────────────────────────────── -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-10 text-center">
    <p class="text-base sm:text-lg text-stone-600 leading-relaxed mb-6">
      A weekly seminar on the methodology of data science, its applications, and related
      governance issues — hosted by the{' '}
      <a
        href="https://www.santannapisa.it/en/istituto/lembeds"
        class="text-[#9f1239] hover:underline font-medium"
        target="_blank"
        rel="noopener"
      >L'EMbeDS Department of Excellence</a>{' '}
      at Sant'Anna School of Advanced Studies, Pisa.
    </p>

    <!-- CTA row -->
    <div class="flex flex-wrap justify-center gap-3 mb-7">
      <a
        href="https://groups.google.com/g/lembeds-ds3"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 bg-white border border-stone-300 text-stone-700 text-sm font-semibold px-5 py-2.5 rounded-full hover:border-stone-400 hover:bg-stone-50 transition-colors"
      >
        Join our Google Group
      </a>
      <a
        href="https://calendar.google.com/calendar/u/0?cid=bGVtYmVkc2RzM0BnbWFpbC5jb20"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 bg-white border border-stone-300 text-stone-700 text-sm font-semibold px-5 py-2.5 rounded-full hover:border-stone-400 hover:bg-stone-50 transition-colors"
      >
        Add our calendar
      </a>
      <a
        href="https://forms.gle/s98j9FEKxyphkbBb6"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 bg-white border border-stone-300 text-stone-700 text-sm font-semibold px-5 py-2.5 rounded-full hover:border-stone-400 hover:bg-stone-50 transition-colors"
      >
        Suggest a speaker
      </a>
    </div>

    <!-- Format legend -->
    <div class="flex flex-wrap justify-center gap-3">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold uppercase tracking-wide border border-blue-100">
        <span class="w-2 h-2 rounded-full bg-blue-600 inline-block shrink-0"></span>
        Lecture — Invited academic talk
      </span>
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold uppercase tracking-wide border border-amber-100">
        <span class="w-2 h-2 rounded-full bg-amber-600 inline-block shrink-0"></span>
        Science Meeting — Ongoing research
      </span>
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold uppercase tracking-wide border border-emerald-100">
        <span class="w-2 h-2 rounded-full bg-emerald-600 inline-block shrink-0"></span>
        Journal Club — Published paper discussion
      </span>
    </div>
  </section>

  <!-- ── FALL 2026 BANNER ───────────────────────────────── -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="rounded-2xl bg-white border border-[#9f1239]/20 px-6 py-5 flex flex-col sm:flex-row items-start sm:items-center gap-4" style="border-left: 4px solid #9f1239;">
      <div class="flex items-center gap-3 shrink-0">
        <svg class="w-6 h-6 text-[#9f1239]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" />
        </svg>
        <span class="font-semibold text-[#9f1239]">Fall 2026 Schedule</span>
      </div>
      <p class="text-sm text-stone-600 leading-relaxed">
        Sessions resume every <strong class="text-stone-900">Wednesday from September 2026</strong>, cycling through
        Lectures, Science Meetings, and Journal Clubs (3:00 PM Italian Time · Online via Teams).
      </p>
    </div>
  </div>

  <!-- ── UPCOMING EVENTS ───────────────────────────────── -->
  {upcomingEvents.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

      <div class="flex items-baseline justify-between mb-8">
        <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-stone-900">Upcoming Events</h2>
        <span class="text-sm text-stone-400">{upcomingEvents.length} scheduled</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {upcomingEvents.map(event => (
          <EventCard event={event} />
        ))}
      </div>
    </section>
  )}

  <!-- ── RECENT EVENTS ─────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">

    <div class="flex items-baseline justify-between mb-8">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-stone-900">Recent Events</h2>
      <span class="text-sm text-stone-400">{totalCount} events total</span>
    </div>

    <!-- 6-card grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
      {recentEvents.map(event => (
        <EventCard event={event} />
      ))}
    </div>

    <!-- Show all button -->
    <div class="flex justify-center">
      <a
        href="/events"
        class="inline-flex items-center gap-2 bg-[#9f1239] text-white text-sm font-semibold px-7 py-3 rounded-full hover:bg-[#881030] transition-colors shadow-sm"
      >
        Show all {totalCount} events
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ── FOOTER ─────────────────────────────────────────── -->
  <footer class="border-t border-stone-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-stone-500">
      <div class="font-serif">
        <span class="font-bold text-[#9f1239]">L'EMbeDS</span>
        <span class="text-stone-600"> DS³</span>
        <span> · Sant'Anna School of Advanced Studies, Pisa</span>
      </div>
      <nav class="flex gap-5">
        <a href="/" class="hover:text-stone-800 transition-colors">Home</a>
        <a href="/events" class="hover:text-stone-800 transition-colors">All Events</a>
        <a href="/credits" class="hover:text-stone-800 transition-colors">Credits & Links</a>
      </nav>
    </div>
  </footer>
</Layout>
