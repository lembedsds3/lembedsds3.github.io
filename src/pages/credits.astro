---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const organizers = [
  {
    name: "Lorenzo Testa",
    role: "Organizer",
    affiliations: [
      "Ph.D. student, Carnegie Mellon University",
      "Junior Research Affiliate, Sant’Anna School of Advanced Studies",
    ],
    url: "https://testalorenzo.github.io",
  },
  {
    name: "Riccardo Porcedda",
    role: "Organizer",
    affiliations: [
      "Sant’Anna School of Advanced Studies",
    ],
    url: "",
  },
  // ── Add further organizers here ───────────────────────────────────
  // {
  //   name: 'Name Surname',
  //   role: 'Organizer',
  //   affiliations: ['Institution'],
  //   url: '',
  // },
];

const relatedSeminars = [
  {
    name: 'International Seminar on Selective Inference',
    when: 'Mondays',
    url: 'https://www.selectiveinferenceseminar.com/home',
  },
  {
    name: 'Online Causal Inference Seminar',
    when: 'Tuesdays',
    url: 'https://sites.google.com/view/ocis/home',
  },
  {
    name: 'Chamberlain Seminar',
    when: 'Fridays',
    url: 'https://sites.google.com/view/chamberlainseminar/home',
  },
];
---

<Layout
  title="Credits & Links — L'EMbeDS DS³"
  description="Organizers and related resources for the L'EMbeDS DS³ seminar series."
>
  <Nav />

  <!-- ── HERO ────────────────────────────────────────────────────── -->
  <div class="relative">
    <img
      src="/fig1.png"
      alt="Pisa"
      class="w-full h-36 sm:h-52 object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#faf8f5]/70 pointer-events-none" />
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 pb-6">
        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white drop-shadow-md">
          Credits &amp; Links
        </h1>
      </div>
    </div>
  </div>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-14">

    <!-- ── ORGANIZERS ─────────────────────────────────────────────── -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-stone-900 mb-6 flex items-center gap-3">
        <span class="w-8 h-0.5 bg-[#9f1239] inline-block rounded-full"></span>
        Organizers
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {organizers.map(org => (
          <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-5 flex items-start gap-4">
            <!-- Initials avatar -->
            <div class="w-12 h-12 rounded-full bg-[#9f1239] flex items-center justify-center text-white text-base font-semibold shrink-0">
              {org.name.split(' ').slice(0, 2).map((w: string) => w[0]).join('')}
            </div>
            <div>
              {org.url ? (
                <a
                  href={org.url}
                  target="_blank"
                  rel="noopener"
                  class="font-semibold text-stone-900 hover:text-[#9f1239] transition-colors"
                >
                  {org.name}
                </a>
              ) : (
                <span class="font-semibold text-stone-900">{org.name}</span>
              )}
              <ul class="mt-1 space-y-0.5">
                {org.affiliations.map((aff: string) => (
                  <li class="text-sm text-stone-500">{aff}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── RELATED SEMINARS ───────────────────────────────────────── -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-stone-900 mb-6 flex items-center gap-3">
        <span class="w-8 h-0.5 bg-[#9f1239] inline-block rounded-full"></span>
        Related Seminars
      </h2>

      <div class="space-y-3">
        {relatedSeminars.map(sem => (
          <a
            href={sem.url}
            target="_blank"
            rel="noopener"
            class="group flex items-center justify-between bg-white rounded-xl border border-stone-100 shadow-sm px-5 py-4 hover:border-[#9f1239]/40 hover:shadow-md transition-all duration-150"
          >
            <div>
              <p class="font-medium text-stone-900 group-hover:text-[#9f1239] transition-colors">{sem.name}</p>
              <p class="text-sm text-stone-500 mt-0.5">{sem.when}</p>
            </div>
            <svg class="w-4 h-4 text-stone-400 group-hover:text-[#9f1239] transition-colors shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- ── ENGAGE ────────────────────────────────────────────────── -->
    <section>
      <h2 class="font-serif text-2xl font-semibold text-stone-900 mb-6 flex items-center gap-3">
        <span class="w-8 h-0.5 bg-[#9f1239] inline-block rounded-full"></span>
        Get Involved
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-5">
          <h3 class="font-semibold text-stone-900 mb-1">Stay updated</h3>
          <p class="text-sm text-stone-500 mb-3">
            Subscribe to the mailing list for announcements and Teams invitations.
          </p>
          <a
            href="https://groups.google.com/g/lembedsds3"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#9f1239] hover:underline"
          >
            Join Google Group
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <div class="bg-white rounded-2xl border border-stone-100 shadow-sm p-5">
          <h3 class="font-semibold text-stone-900 mb-1">Suggest a speaker</h3>
          <p class="text-sm text-stone-500 mb-3">
            Know someone who would make a great speaker? Let us know.
          </p>
          <a
            href="https://forms.google.com"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#9f1239] hover:underline"
          >
            Submit suggestion
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- ── FOOTER ───────────────────────────────────────────────────── -->
  <footer class="border-t border-stone-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-stone-500">
      <div class="font-serif">
        <span class="font-bold text-[#9f1239]">L'EMbeDS</span>
        <span class="text-stone-600"> DS³</span>
        <span> · Sant'Anna School of Advanced Studies, Pisa</span>
      </div>
      <nav class="flex gap-5">
        <a href="/" class="hover:text-stone-800 transition-colors">Events</a>
        <a href="/credits" class="hover:text-stone-800 transition-colors">Credits & Links</a>
      </nav>
    </div>
  </footer>
</Layout>
