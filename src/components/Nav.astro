---
const { pathname } = Astro.url;

const links = [
  { href: '/',        label: 'Home'            },
  { href: '/events',  label: 'All Events'      },
  { href: '/credits', label: 'Credits & Links' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-white/85 border-b border-stone-200/80 shadow-sm">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="font-serif text-xl font-bold text-[#9f1239] group-hover:opacity-80 transition-opacity">
        L'EMbeDS
      </span>
      <span class="font-serif text-xl font-bold text-stone-700 group-hover:opacity-80 transition-opacity">
        DS³
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden sm:flex items-center gap-1">
      {links.map(({ href, label }) => {
        const isActive = pathname === href || (href !== '/' && pathname.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class={`px-4 py-2 rounded-full text-sm font-medium transition-all duration-150 ${
                isActive
                  ? 'bg-[#9f1239] text-white'
                  : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100'
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="sm:hidden p-2 rounded-lg text-stone-600 hover:bg-stone-100 transition-colors"
      aria-label="Toggle menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-stone-200 bg-white/95">
    <ul class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="block px-4 py-2.5 rounded-lg text-sm font-medium text-stone-700 hover:bg-stone-100 transition-colors"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
