---
export interface EventResource {
  label: string;
  url: string;
}

export interface EventData {
  id: string;
  date: string;
  type: 'lecture' | 'journal-club' | 'science-meeting';
  title: string;
  speaker: string;
  affiliation: string;
  website: string;
  abstract: string;
  photo: string;
  resources?: EventResource[];
}

interface Props {
  event: EventData;
}

const { event } = Astro.props;

const cfg = {
  lecture: {
    label:      'Lecture',
    badgeCls:   'badge-lecture',
    headerCls:  'bg-blue-50',
    avatarCls:  'avatar-lecture',
    detailCls:  'detail-lecture',
    chevronCls: 'chevron-lecture',
    borderCls:  'border-blue-100',
  },
  'journal-club': {
    label:      'Journal Club',
    badgeCls:   'badge-jclub',
    headerCls:  'bg-emerald-50',
    avatarCls:  'avatar-jclub',
    detailCls:  'detail-jclub',
    chevronCls: 'chevron-jclub',
    borderCls:  'border-emerald-100',
  },
  'science-meeting': {
    label:      'Science Meeting',
    badgeCls:   'badge-scimeeting',
    headerCls:  'bg-amber-50',
    avatarCls:  'avatar-scimeeting',
    detailCls:  'detail-scimeeting',
    chevronCls: 'chevron-scimeeting',
    borderCls:  'border-amber-100',
  },
}[event.type];

const dateObj = new Date(event.date + 'T12:00:00');
const formatted = dateObj.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const initials = event.speaker
  .split(/\s+/)
  .filter(w => !['et', 'al.', 'al'].includes(w.toLowerCase()))
  .slice(0, 2)
  .map(w => w.charAt(0).toUpperCase())
  .join('');
---

<article class={`event-card bg-white rounded-2xl shadow-sm border ${cfg.borderCls} overflow-hidden flex flex-col hover:shadow-md transition-shadow duration-200`}>

  <!-- Photo / avatar header -->
  <div class={`${cfg.headerCls} px-6 pt-6 pb-5 flex justify-center`}>
    {event.photo ? (
      <div class="relative">
        <img
          src={`/images/speakers/${event.photo}`}
          alt={event.speaker}
          class="speaker-img w-24 h-24 rounded-full object-cover ring-4 ring-white shadow-sm"
        />
        <div class={`speaker-fallback hidden w-24 h-24 rounded-full ${cfg.avatarCls} items-center justify-center text-white ring-4 ring-white shadow-sm`}>
          {event.type === 'journal-club' ? (
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
          ) : event.type === 'science-meeting' ? (
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 01-6.23-1.307L5 14.5M19.8 15.3l1.401 1.401c1.294 1.295.365 3.512-1.464 3.512H4.263c-1.83 0-2.758-2.217-1.464-3.512L5 14.5" />
            </svg>
          ) : (
            <span class="text-2xl font-semibold">{initials}</span>
          )}
        </div>
      </div>
    ) : (
      <div class={`w-24 h-24 rounded-full ${cfg.avatarCls} flex items-center justify-center ring-4 ring-white shadow-sm`}>
        {event.type === 'journal-club' ? (
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
        ) : event.type === 'science-meeting' ? (
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 01-6.23-1.307L5 14.5M19.8 15.3l1.401 1.401c1.294 1.295.365 3.512-1.464 3.512H4.263c-1.83 0-2.758-2.217-1.464-3.512L5 14.5" />
          </svg>
        ) : (
          <span class="text-white text-2xl font-semibold">{initials}</span>
        )}
      </div>
    )}
  </div>

  <!-- Card body -->
  <div class="px-5 pb-5 pt-1 flex flex-col flex-1">

    <!-- Type badge + date -->
    <div class="flex items-center justify-between mb-3">
      <span class={`${cfg.badgeCls} text-white text-xs font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full`}>
        {cfg.label}
      </span>
      <time datetime={event.date} class="text-xs text-stone-400 font-medium tabular-nums">
        {formatted}
      </time>
    </div>

    <!-- Title -->
    <h3 class="font-serif text-[0.95rem] leading-snug font-semibold text-stone-900 mb-2">
      {event.title}
    </h3>

    <!-- Speaker name — linked if website exists -->
    {event.website ? (
      <a
        href={event.website}
        target="_blank"
        rel="noopener"
        class={`text-sm font-semibold ${cfg.detailCls} hover:underline underline-offset-2`}
      >
        {event.speaker}
      </a>
    ) : (
      <p class={`text-sm font-semibold ${cfg.detailCls}`}>{event.speaker}</p>
    )}
    {event.affiliation && (
      <p class="text-xs text-stone-500 mt-0.5 leading-relaxed">{event.affiliation}</p>
    )}

    <!-- Abstract / Resources triggers — open full modal -->
    {(event.abstract || (event.resources && event.resources.length > 0)) && (
      <div class="flex flex-wrap items-center gap-4 mt-4">
        {event.abstract && (
          <button
            class={`abstract-trigger flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide cursor-pointer ${cfg.chevronCls} hover:opacity-75 transition-opacity`}
            data-title={event.title}
            data-speaker={event.speaker}
            data-affiliation={event.affiliation}
            data-date={formatted}
            data-type={event.type}
            data-abstract={event.abstract}
            data-website={event.website}
            data-resources={JSON.stringify(event.resources ?? [])}
          >
            <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd" />
            </svg>
            Abstract
          </button>
        )}
        {event.resources && event.resources.length > 0 && (
          <button
            class={`abstract-trigger flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide cursor-pointer ${cfg.chevronCls} hover:opacity-75 transition-opacity`}
            data-title={event.title}
            data-speaker={event.speaker}
            data-affiliation={event.affiliation}
            data-date={formatted}
            data-type={event.type}
            data-abstract={event.abstract}
            data-website={event.website}
            data-resources={JSON.stringify(event.resources)}
          >
            <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd" />
            </svg>
            Additional Resources
          </button>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .badge-lecture     { background-color: #2563eb; }
  .badge-jclub       { background-color: #059669; }
  .badge-scimeeting  { background-color: #d97706; }

  .avatar-lecture    { background-color: #2563eb; }
  .avatar-jclub      { background-color: #059669; }
  .avatar-scimeeting { background-color: #d97706; }

  .detail-lecture    { color: #1d4ed8; }
  .detail-jclub      { color: #047857; }
  .detail-scimeeting { color: #b45309; }

  .chevron-lecture    { color: #1d4ed8; }
  .chevron-jclub      { color: #047857; }
  .chevron-scimeeting { color: #b45309; }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>('.speaker-img').forEach(img => {
    img.addEventListener('error', function () {
      this.style.display = 'none';
      const fallback = this.parentElement?.querySelector<HTMLElement>('.speaker-fallback');
      if (fallback) fallback.style.display = 'flex';
    });
  });
</script>
